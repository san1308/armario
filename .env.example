DATABASE_URL=sqlite:///./data/armario.db
DATA_DIR=./data

# ── Usuarios (Cloudflare Access) ───────────────────────────────────────────────
# Recomendado: validar el JWT de Cloudflare Access. Con esto, aunque alguien
# llegue al puerto 8006 por la LAN, no puede hacerse pasar por otro usuario.
#   Team domain: Zero Trust → Settings → Custom Pages ("<equipo>.cloudflareaccess.com")
#   AUD: Zero Trust → Access → Applications → (la app) → Overview → Application Audience (AUD) Tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Opcional: limitar a estos emails (separados por comas). Vacío = los que deje pasar Access.
EMAILS_PERMITIDOS=

# Solo desarrollo local (sin Cloudflare delante): usuario por defecto.
DEV_EMAIL=

# ── Procesado ─────────────────────────────────────────────────────────────────
MODELO_RECORTE=isnet-general-use

APP_PORT=8006
DEBUG=false
